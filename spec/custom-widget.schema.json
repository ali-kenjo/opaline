{
  "$defs": {
    "Align": {
      "enum": [
        "start",
        "center",
        "end",
        "stretch",
        "baseline"
      ],
      "type": "string"
    },
    "Axis": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "type": "string"
    },
    "Caps": {
      "enum": [
        "round",
        "butt"
      ],
      "type": "string"
    },
    "CommandRef": {
      "description": "A command for core, which validates it before acting (ARCHITECTURE §3.7). `cmd` is a command\nname of the IPC protocol; the arguments are expressions, and `$value` is the control's new\nvalue (slider, toggle, text input).",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          },
          "type": "object"
        },
        "cmd": {
          "type": "string"
        }
      },
      "required": [
        "cmd"
      ],
      "type": "object"
    },
    "Composition": {
      "description": "A widget as a tree of containers and blocks, with one layout per size.",
      "properties": {
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          },
          "description": "Named values shared by every layout, read in expressions as `bind.<name>`. A widget's\nfields become bindings. Bindings may read other bindings, but not in a circle.",
          "type": "object"
        },
        "layouts": {
          "description": "Layouts, tried in order; the first that matches the widget's size is used.",
          "items": {
            "$ref": "#/$defs/Layout"
          },
          "type": "array"
        },
        "version": {
          "description": "Format version (1).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "layouts"
      ],
      "type": "object"
    },
    "Expr": {
      "description": "An expression (docs/EXPRESSIONS.md): `cpu.load >= 90`, `clamp(battery.percent / 100, 0, 1)`.",
      "type": "string"
    },
    "Fit": {
      "enum": [
        "cover",
        "contain"
      ],
      "type": "string"
    },
    "HistoryRef": {
      "description": "Core's history of a path over a window (`'5m'`), for charts.",
      "properties": {
        "path": {
          "type": "string"
        },
        "window": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "window"
      ],
      "type": "object"
    },
    "Justify": {
      "enum": [
        "start",
        "center",
        "end",
        "between",
        "around",
        "evenly"
      ],
      "type": "string"
    },
    "Layout": {
      "description": "One layout: the sizes it's for and its tree.",
      "properties": {
        "minH": {
          "description": "For free sizes: the smallest height in grid cells this layout fits.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minW": {
          "description": "For free sizes: the smallest width in grid cells this layout fits.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "root": {
          "$ref": "#/$defs/Node"
        },
        "sizes": {
          "description": "Size classes this layout is for; empty means any.",
          "items": {
            "$ref": "#/$defs/SizeClass"
          },
          "type": "array"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    },
    "Node": {
      "description": "A container or a block.",
      "oneOf": [
        {
          "description": "Children side by side when the box is wider than tall, else one under the other.",
          "properties": {
            "align": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Align"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cross-axis alignment of the children."
            },
            "children": {
              "items": {
                "$ref": "#/$defs/Node"
              },
              "type": "array"
            },
            "gap": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "grow": {
              "description": "Share of the free space this container takes in its parent (like flex-grow).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "justify": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Justify"
