{
  "$schema": "file:///usr/share/opaline/schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "opaline",
  "name": "Opaline",
  "author": "Opaline",
  "version": "2.0.0",
  "license": "GPL-3.0-or-later",
  "description": "The Opaline 2.0 default look: see-through glass (blur 30, transparency 75), bold condensed Roboto Flex numerals, meaningful shapes, and harmonized per-widget color accents.",
  "minOpalineVersion": "2.0.0",
  "tokens": {
    "colorSource": "wallpaper",
    "variant": "expressive",
    "motionPersonality": "expressive",
    "shapeLanguage": "meaningful"
  },
  "style": {
    "surface": "glass",
    "transparency": 75,
    "blur": 30,
    "see": "wallpaper",
    "refraction": 75,
    "rim": 80,
    "grain": 40,
    "shadow": 40,
    "legibility": true,
    "fontFamily": "Inter",
    "numberFontFamily": "Roboto Flex",
    "headerStyle": "none",
    "iconSet": "rounded",
    "hoverEffect": "lift",
    "roles": {
      "hero": {
        "fontFamily": "Roboto Flex",
        "fontWeight": 780,
        "fontWidth": 30,
        "letterSpacing": -0.015,
        "lineHeight": 0.86,
        "tabularNumbers": true
      },
      "unit": {
        "fontFamily": "Roboto Flex",
        "fontWeight": 600,
        "fontWidth": 60
      },
      "value": {
        "fontFamily": "Roboto Flex",
        "fontWeight": 650,
        "fontWidth": 80,
        "tabularNumbers": true
      },
      "title": {
        "fontFamily": "Inter",
        "fontWeight": 600
      },
      "label": {
        "fontFamily": "Inter",
        "fontWeight": 450,
        "opacity": 74
      },
      "caption": {
        "fontFamily": "Inter",
        "fontWeight": 450,
        "opacity": 74
      }
    }
  },
  "kinds": {
    "clock": {
      "accentColor": "#8f7cf0"
    },
    "cpu": {
      "accentColor": "#f2903a"
    },
    "memory": {
      "accentColor": "#9d7cf0"
    },
    "gpu": {
      "accentColor": "#7aa7ff"
    },
    "storage": {
      "accentColor": "#e8a84a"
    },
    "network": {
      "accentColor": "#3ec9d4"
    },
    "battery": {
      "accentColor": "#50c896"
    },
    "fans": {
      "accentColor": "#f2903a"
    },
    "weather": {
      "accentColor": "#6aa8ff"
    },
    "media": {
      "accentColor": "#e0609a"
    },
    "visualizer": {
      "accentColor": "#e0609a"
    }
  }
}
