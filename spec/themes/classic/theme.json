{
  "$schema": "file:///usr/share/opaline/schemas/theme.schema.json",
  "schemaVersion": 1,
  "id": "classic",
  "name": "Classic",
  "author": "Opaline",
  "version": "1.1.0",
  "license": "GPL-3.0-or-later",
  "description": "The original Opaline 1.1 look: frosted glass (blur 60, transparency 60), standard card headers, and uniform Material 3 typography.",
  "minOpalineVersion": "1.0.0",
  "tokens": {
    "colorSource": "wallpaper",
    "variant": "tonal-spot",
    "motionPersonality": "standard",
    "shapeLanguage": "rounded"
  },
  "style": {
    "surface": "glass",
    "transparency": 60,
    "blur": 60,
    "see": "wallpaper",
    "refraction": 50,
    "rim": 50,
    "grain": 50,
    "shadow": 50,
    "borderWidth": 0,
    "legibility": true,
    "fontFamily": "Inter",
    "numberFontFamily": "Roboto Flex",
    "fontWeight": 400,
    "fontWidth": 100,
    "headerStyle": "icon-title",
    "iconSet": "rounded",
    "hoverEffect": "lift"
  }
}
