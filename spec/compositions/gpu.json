              },
              {
                "id": "asleep-txt",
                "type": "text",
                "role": "value",
                "text": "Asleep · 0 W"
              }
            ]
          },
          {
            "id": "awake",
            "type": "column",
            "justify": "between",
            "gap": 2,
            "grow": 1,
            "visible": "bind.pAwake",
            "children": [
              {
                "id": "top",
                "type": "row",
                "align": "center",
                "justify": "between",
                "gap": 2,
                "children": [
                  {
                    "id": "load",
                    "type": "number",
                    "role": "hero",
                    "value": "bind.pLoad",
                    "text": "{round(bind.pLoad)}",
                    "unit": "%"
                  },
                  {
                    "id": "temp",
                    "type": "canvas",
                    "visual": "thermal-badge",
                    "label": "GPU temperature",
                    "params": {
                      "tempC": "bind.pTemp",
                      "text": "bind.pTempText"
                    }
                  }
                ]
              },
              {
                "id": "vram-col",
                "type": "column",
                "gap": 1,
                "children": [
                  {
                    "id": "vram-lbl",
                    "type": "text",
                    "role": "caption",
                    "text": "VRAM · {bind.pVramText}"
                  },
                  {
                    "id": "vram-bar",
                    "type": "bar",
                    "value": "bind.pVramRatio",
                    "color": "ramp(bind.pVramRatio, 'load')"
                  }
                ]
              },
              {
                "id": "foot",
                "type": "row",
                "justify": "between",
                "gap": 2,
                "children": [
                  {
                    "id": "pwr",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.pPowerText}"
                  },
                  {
                    "id": "clk",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.pClockText}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "sizes": [
        "M"
      ],
      "root": {
        "id": "root",
        "type": "row",
        "align": "stretch",
        "gap": 3,
        "children": [
          {
            "id": "dual",
            "type": "row",
            "align": "stretch",
            "gap": 3,
            "grow": 1,
            "visible": "bind.hasMulti",
            "children": [
              {
                "id": "igpu",
                "type": "column",
                "justify": "between",
                "gap": 1,
                "grow": 1,
                "children": [
                  {
                    "id": "igpu-name",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.g0Name}"
                  },
                  {
                    "id": "igpu-load",
                    "type": "number",
                    "role": "hero",
                    "value": "gpu0.load",
                    "text": "{if(gpu0.load != null, string(round(gpu0.load)), '—')}",
                    "unit": "%"
                  },
                  {
                    "id": "igpu-clk",
                    "type": "text",
                    "role": "value",
                    "text": "{bind.g0ClockText}"
                  },
                  {
                    "id": "igpu-mem",
                    "type": "text",
                    "role": "caption",
                    "text": "Shared memory"
                  }
                ]
              },
              {
                "id": "div",
                "type": "divider",
                "axis": "vertical"
              },
              {
                "id": "dgpu-asleep",
                "type": "column",
                "align": "center",
                "justify": "center",
                "gap": 1,
                "grow": 1,
                "visible": "!bind.g1Awake",
                "children": [
                  {
                    "id": "dgpu-asleep-name",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.g1Name}"
                  },
                  {
                    "id": "dgpu-asleep-moon",
                    "type": "icon",
                    "icon": "bedtime",
                    "filled": "true"
                  },
                  {
                    "id": "dgpu-asleep-txt",
                    "type": "text",
                    "role": "value",
                    "text": "Asleep · 0 W"
                  }
                ]
              },
              {
                "id": "dgpu",
                "type": "column",
                "justify": "between",
                "gap": 1,
                "grow": 1,
                "visible": "bind.g1Awake",
                "children": [
                  {
                    "id": "dgpu-name",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.g1Name}"
                  },
                  {
                    "id": "dgpu-top",
                    "type": "row",
                    "align": "center",
                    "justify": "between",
                    "gap": 1,
                    "children": [
                      {
                        "id": "dgpu-load",
                        "type": "number",
                        "role": "hero",
                        "value": "gpu1.load",
                        "text": "{if(gpu1.load != null, string(round(gpu1.load)), '—')}",
                        "unit": "%"
                      },
                      {
                        "id": "dgpu-temp",
                        "type": "canvas",
                        "visual": "thermal-badge",
                        "label": "GPU temperature",
                        "params": {
                          "tempC": "gpu1.temp",
                          "text": "bind.g1TempText"
                        }
                      }
                    ]
                  },
                  {
                    "id": "dgpu-vram-txt",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.g1VramText}"
                  },
                  {
                    "id": "dgpu-vram-bar",
                    "type": "bar",
                    "value": "bind.g1VramRatio",
                    "color": "ramp(bind.g1VramRatio, 'load')"
                  }
                ]
              }
            ]
          },
          {
            "id": "single",
            "type": "row",
            "align": "stretch",
            "gap": 3,
            "grow": 1,
            "visible": "!bind.hasMulti",
            "children": [
              {
                "id": "single-asleep",
                "type": "column",
                "align": "center",
                "justify": "center",
                "gap": 1,
                "grow": 1,
                "visible": "!bind.pAwake",
                "children": [
                  {
                    "id": "single-asleep-name",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.pName}"
                  },
                  {
                    "id": "single-asleep-moon",
                    "type": "icon",
                    "icon": "bedtime",
                    "filled": "true"
                  },
                  {
                    "id": "single-asleep-txt",
                    "type": "text",
                    "role": "value",
                    "text": "Asleep · 0 W"
                  }
                ]
              },
              {
                "id": "single-awake",
                "type": "row",
                "align": "stretch",
                "gap": 3,
                "grow": 1,
                "visible": "bind.pAwake",
                "children": [
                  {
                    "id": "s-left",
                    "type": "column",
                    "justify": "between",
                    "gap": 1,
                    "children": [
                      {
                        "id": "s-name",
                        "type": "text",
                        "role": "caption",
                        "text": "{bind.pName}"
                      },
                      {
                        "id": "s-load",
                        "type": "number",
                        "role": "hero",
                        "value": "bind.pLoad",
                        "text": "{round(bind.pLoad)}",
                        "unit": "%"
                      },
                      {
                        "id": "s-vram-txt",
                        "type": "text",
                        "role": "caption",
                        "text": "{bind.pVramText}"
                      },
                      {
                        "id": "s-vram-bar",
                        "type": "bar",
                        "value": "bind.pVramRatio",
