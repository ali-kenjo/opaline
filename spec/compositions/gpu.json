{
  "version": 1,
  "bindings": {
    "hasMulti": "len(gpu.list) > 1 && opt.multiGpu != 'single'",
    "binary": "opt.byteUnit == 'gib'",
    "byteStyle": "if(bind.binary, 'iec', 'si')",
    "g0Name": "gpu.list[0].name ?? 'Integrated GPU'",
    "g1Name": "gpu.list[1].name ?? 'Discrete GPU'",
    "g0Awake": "gpu0.state.awake != false",
    "g1Awake": "gpu1.state.awake != false",
    "useOne": "opt.primaryIndex == 1 && len(gpu.list) > 1",
    "pName": "if(bind.useOne, bind.g1Name, bind.g0Name)",
    "pAwake": "if(bind.useOne, bind.g1Awake, bind.g0Awake)",
    "pLoad": "if(bind.useOne, gpu1.load, gpu0.load)",
    "pTemp": "if(bind.useOne, gpu1.temp, gpu0.temp)",
    "pTempDisp": "if(opt.tempUnit == 'f', bind.pTemp * 9 / 5 + 32, bind.pTemp)",
    "pTempText": "if(bind.pTempDisp != null, string(round(bind.pTempDisp)) + if(opt.tempUnit == 'f', '°F', '°'), '—')",
    "g1TempDisp": "if(opt.tempUnit == 'f', gpu1.temp * 9 / 5 + 32, gpu1.temp)",
    "g1TempText": "if(bind.g1TempDisp != null, string(round(bind.g1TempDisp)) + if(opt.tempUnit == 'f', '°F', '°'), '—')",
    "pVramRatio": "clamp((if(bind.useOne, gpu1.vram.percent, gpu0.vram.percent) ?? 0) / 100, 0, 1)",
    "pVramText": "if(if(bind.useOne, gpu1.vram.totalB, gpu0.vram.totalB) != null, bytes(if(bind.useOne, gpu1.vram.usedB, gpu0.vram.usedB) ?? 0, bind.byteStyle) + ' / ' + bytes(if(bind.useOne, gpu1.vram.totalB, gpu0.vram.totalB), bind.byteStyle), 'Shared memory')",
    "g1VramRatio": "clamp((gpu1.vram.percent ?? 0) / 100, 0, 1)",
    "g1VramText": "if(gpu1.vram.totalB != null, bytes(gpu1.vram.usedB ?? 0, bind.byteStyle) + ' / ' + bytes(gpu1.vram.totalB, bind.byteStyle), 'Shared')",
    "pPowerW": "if(bind.useOne, gpu1.power.watts, gpu0.power.watts)",
    "pLimitW": "if(bind.useOne, gpu1.power.limitW, gpu0.power.limitW)",
    "pPowerRatio": "if(bind.pPowerW != null && bind.pLimitW != null && bind.pLimitW > 0, clamp(bind.pPowerW / bind.pLimitW, 0, 1), 0)",
    "pPowerText": "if(bind.pPowerW != null, fixed(bind.pPowerW, 1) + ' W' + if(bind.pLimitW != null, ' / ' + string(round(bind.pLimitW)) + ' W', ''), '—')",
    "g0ClockText": "if(gpu0.clocks.coreMHz != null, string(round(gpu0.clocks.coreMHz)) + ' MHz', '—')",
    "g1ClockText": "if(gpu1.clocks.coreMHz != null, string(round(gpu1.clocks.coreMHz)) + ' MHz', '—')",
    "pClockText": "if(bind.useOne, bind.g1ClockText, bind.g0ClockText)",
    "pFanText": "if(if(bind.useOne, gpu1.fan.rpm, gpu0.fan.rpm) != null, string(round(if(bind.useOne, gpu1.fan.rpm, gpu0.fan.rpm))) + ' rpm', if(if(bind.useOne, gpu1.fan.percent, gpu0.fan.percent) != null, string(round(if(bind.useOne, gpu1.fan.percent, gpu0.fan.percent))) + '%', ''))",
    "pApps": "if(bind.useOne, gpu1.processes, gpu0.processes)"
  },
  "layouts": [
    {
      "sizes": [
        "1x1"
      ],
      "root": {
        "id": "root",
        "type": "column",
        "align": "center",
        "justify": "center",
        "children": [
          {
            "id": "load",
            "type": "number",
            "role": "hero",
            "value": "bind.pLoad",
            "text": "{round(bind.pLoad)}",
            "unit": "%",
            "visible": "bind.pAwake"
          },
          {
            "id": "moon",
            "type": "icon",
            "icon": "bedtime",
            "filled": "true",
            "visible": "!bind.pAwake"
          }
        ]
      }
    },
    {
      "sizes": [
        "2x1",
        "4x1"
      ],
      "root": {
        "id": "root",
        "type": "row",
        "align": "center",
        "justify": "between",
        "gap": 2,
        "children": [
          {
            "id": "asleep",
            "type": "column",
            "align": "center",
            "justify": "center",
            "gap": 1,
            "grow": 1,
            "visible": "!bind.pAwake",
            "children": [
              {
                "id": "asleep-name",
                "type": "text",
                "role": "caption",
                "text": "{bind.pName}"
              },
              {
                "id": "asleep-moon",
                "type": "icon",
                "icon": "bedtime",
                "filled": "true"
              },
              {
                "id": "asleep-txt",
                "type": "text",
                "role": "value",
                "text": "Asleep · 0 W"
              }
            ]
          },
          {
            "id": "awake-row",
            "type": "row",
            "align": "center",
            "justify": "between",
            "gap": 2,
            "grow": 1,
            "visible": "bind.pAwake",
            "children": [
              {
                "id": "load",
                "type": "number",
                "role": "hero",
                "value": "bind.pLoad",
                "text": "{round(bind.pLoad)}",
                "unit": "%"
              },
              {
                "id": "meta",
                "type": "column",
                "gap": 0,
                "children": [
                  {
                    "id": "vram",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.pVramText}"
                  },
                  {
                    "id": "pwr",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.pPowerText}"
                  }
                ]
              },
              {
                "id": "temp",
                "type": "canvas",
                "visual": "thermal-badge",
                "label": "GPU temperature",
                "params": {
                  "tempC": "bind.pTemp",
                  "text": "bind.pTempText"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "sizes": [
        "S"
      ],
      "root": {
        "id": "root",
        "type": "column",
        "justify": "between",
        "gap": 2,
        "children": [
          {
            "id": "asleep",
            "type": "column",
            "align": "center",
