                    "unit": "%"
                  },
                  {
                    "id": "igpu-clk",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.g0ClockText} · Shared"
                  }
                ]
              },
              {
                "id": "div",
                "type": "divider",
                "axis": "vertical",
                "visible": "bind.hasMulti"
              },
              {
                "id": "p-asleep",
                "type": "column",
                "align": "center",
                "justify": "center",
