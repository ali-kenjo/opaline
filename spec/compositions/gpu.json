                  },
                  {
                    "id": "p-vram-bar",
                    "type": "bar",
                    "value": "bind.pVramRatio",
                    "color": "ramp(bind.pVramRatio, 'load')"
                  }
                ]
              }
            ]
          },
          {
            "id": "mid",
            "type": "row",
            "align": "stretch",
            "gap": 3,
            "grow": 1,
            "visible": "bind.pAwake",
            "children": [
              {
                "id": "pwr-box",
                "type": "column",
                "align": "center",
                "justify": "center",
                "gap": 1,
                "children": [
                  {
                    "id": "pwr-gauge",
                    "type": "ring",
                    "value": "bind.pPowerRatio",
                    "sweep": 220,
                    "ticks": 7,
                    "color": "ramp(bind.pPowerRatio, 'load')"
                  },
                  {
                    "id": "pwr-val",
                    "type": "text",
                    "role": "caption",
                    "text": "{bind.pPowerText}"
                  },
                  {
                    "id": "fan-val",
                    "type": "text",
                    "role": "caption",
                    "text": "Fan {bind.pFanText}",
                    "visible": "len(bind.pFanText) > 0"
                  }
                ]
              },
              {
                "id": "eng-box",
                "type": "column",
                "justify": "center",
                "gap": 2,
                "grow": 1,
                "children": [
                  {
                    "id": "eng1",
                    "type": "canvas",
                    "visual": "gpu-engines",
                    "label": "GPU engines",
                    "params": {
                      "render3d": "gpu1.engines.render3d",
                      "video": "gpu1.engines.video",
                      "copy": "gpu1.engines.copy",
                      "compute": "gpu1.engines.compute"
                    },
                    "visible": "bind.useOne"
                  },
                  {
                    "id": "eng0",
                    "type": "canvas",
                    "visual": "gpu-engines",
                    "label": "GPU engines",
                    "params": {
                      "render3d": "gpu0.engines.render3d",
                      "video": "gpu0.engines.video",
                      "copy": "gpu0.engines.copy",
                      "compute": "gpu0.engines.compute"
                    },
                    "visible": "!bind.useOne"
                  },
                  {
                    "id": "clk-line",
                    "type": "text",
                    "role": "caption",
                    "text": "Core {bind.pClockText}"
                  }
                ]
              }
            ]
          },
          {
            "id": "apps",
            "type": "canvas",
            "visual": "app-list",
            "label": "Top GPU apps",
            "params": {
              "apps": "bind.pApps",
              "metric": "'gpu'",
              "binary": "bind.binary",
              "max": "3"
            }
          }
        ]
      }
    }
  ]
}
