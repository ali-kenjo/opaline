              },
              {
                "id": "primary",
                "type": "column",
                "justify": "between",
                "gap": 1,
                "grow": 1,
                "visible": "bind.pAwake",
                "children": [
                  {
                    "id": "p-name",
                    "type": "text",
                    "role": "title",
                    "text": "{bind.pName}"
                  },
                  {
                    "id": "p-row",
                    "type": "row",
