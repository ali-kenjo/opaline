                      }
                    ]
                  },
                  {
                    "id": "s-right",
                    "type": "column",
                    "justify": "between",
                    "gap": 2,
                    "grow": 1,
                    "children": [
                      {
                        "id": "s-stats",
                        "type": "row",
                        "align": "center",
                        "justify": "between",
                        "gap": 2,
                        "children": [
                          {
                            "id": "s-pwr",
                            "type": "column",
                            "gap": 0,
                            "children": [
                              {
                                "id": "s-w",
                                "type": "text",
                                "role": "value",
                                "text": "{bind.pPowerText}"
                              },
                              {
                                "id": "s-clk",
                                "type": "text",
                                "role": "caption",
                                "text": "{bind.pClockText}"
                              }
                            ]
                          },
                          {
                            "id": "s-temp",
                            "type": "canvas",
                            "visual": "thermal-badge",
                            "label": "GPU temperature",
                            "params": {
                              "tempC": "bind.pTemp",
                              "text": "bind.pTempText"
                            }
                          }
                        ]
                      },
                      {
                        "id": "eng1",
                        "type": "canvas",
                        "visual": "gpu-engines",
                        "label": "GPU engines",
                        "params": {
                          "render3d": "gpu1.engines.render3d",
                          "video": "gpu1.engines.video",
                          "copy": "gpu1.engines.copy",
                          "compute": "gpu1.engines.compute"
                        },
                        "visible": "bind.useOne"
                      },
                      {
                        "id": "eng0",
                        "type": "canvas",
                        "visual": "gpu-engines",
                        "label": "GPU engines",
                        "params": {
                          "render3d": "gpu0.engines.render3d",
                          "video": "gpu0.engines.video",
                          "copy": "gpu0.engines.copy",
                          "compute": "gpu0.engines.compute"
                        },
                        "visible": "!bind.useOne"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "sizes": [
        "L",
        "XL"
      ],
      "root": {
        "id": "root",
        "type": "column",
        "gap": 3,
        "children": [
          {
            "id": "top",
            "type": "row",
            "align": "stretch",
            "gap": 3,
            "children": [
              {
                "id": "igpu",
                "type": "column",
                "justify": "between",
                "gap": 1,
                "grow": 1,
                "visible": "bind.hasMulti",
                "children": [
                  {
                    "id": "igpu-name",
                    "type": "text",
                    "role": "title",
                    "text": "{bind.g0Name}"
                  },
                  {
                    "id": "igpu-load",
                    "type": "number",
                    "role": "hero",
                    "value": "gpu0.load",
