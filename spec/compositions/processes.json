      "minW": 4,
      "minH": 4,
      "root": {
        "id": "root",
        "type": "column",
        "gap": 2,
        "children": [
          {
            "id": "table",
            "type": "canvas",
            "visual": "process-table",
            "label": "Processes",
            "params": {
              "apps": "processes.apps",
              "procs": "processes.list",
              "group": "opt.group",
              "sort": "opt.sort",
              "showSystem": "opt.showSystem",
