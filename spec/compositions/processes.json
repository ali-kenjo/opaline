              "compact": "false",
              "showSearch": "opt.showSearch",
              "showIo": "procMeta.showIo",
              "showCount": "procMeta.showCount",
              "showBar": "procMeta.showBar",
              "gpuLoad": "procMeta.gpuLoad"
            }
          }
        ]
      }
