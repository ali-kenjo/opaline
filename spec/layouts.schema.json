{
  "$defs": {
    "FreeAnchor": {
      "enum": [
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right",
        "center"
      ],
      "type": "string"
    },
    "FreeRect": {
      "description": "Work-area-anchored pixel placement for Free mode (brief §7): stays coherent across\nresolution, scale, and monitor changes.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/FreeAnchor",
          "default": "top-left"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "offsetX": {
          "format": "int32",
          "type": "integer"
        },
        "offsetY": {
          "format": "int32",
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "offsetX",
        "offsetY",
        "width",
        "height"
      ],
      "type": "object"
    },
    "LayoutItem": {
      "oneOf": [
        {
          "properties": {
            "free": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FreeRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "groupId": {
              "type": [
                "string",
                "null"
              ]
            },
            "h": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "locked": {
              "type": "boolean"
            },
            "type": {
              "const": "widget",
              "type": "string"
            },
            "w": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "z": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "id",
            "kind",
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        },
        {
          "properties": {
            "activeIndex": {
              "default": 0,
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "children": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "free": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FreeRect"
                },
                {
                  "type": "null"
                }
              ]
            },
            "groupId": {
              "type": [
                "string",
                "null"
              ]
            },
            "h": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "locked": {
              "type": "boolean"
            },
            "smartRotate": {
              "default": false,
              "type": "boolean"
            },
            "smartRules": {
              "items": {
                "$ref": "#/$defs/SmartStackRule"
              },
              "type": "array"
            },
            "type": {
              "const": "stack",
              "type": "string"
            },
            "w": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "y": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "z": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "id",
            "x",
            "y",
            "w",
            "h",
            "children"
          ],
          "type": "object"
        }
      ]
    },
    "LayoutMode": {
      "enum": [
        "grid",
        "free"
      ],
      "type": "string"
    },
    "MonitorLayout": {
      "properties": {
        "cellSize": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LayoutItem"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/LayoutMode"
        }
      },
      "type": "object"
    },
    "SmartStackRule": {
      "description": "Custom expression rule for Smart Rotate inside a widget stack (brief §6.2).",
      "properties": {
        "childId": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "when": {
          "type": "string"
        }
      },
      "required": [
        "childId",
        "when"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "$schema": {
      "default": "file:///usr/share/opaline/schemas/layouts.schema.json",
      "type": [
        "string",
        "null"
      ]
    },
    "monitors": {
      "additionalProperties": {
        "$ref": "#/$defs/MonitorLayout"
      },
      "default": {},
      "type": "object"
    },
    "showMissingOnPrimary": {
      "default": false,
      "description": "When a saved monitor is disconnected, show its waiting widgets on the primary display.",
      "type": "boolean"
    },
    "version": {
      "default": 1,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "Layouts",
  "type": "object"
}
