#!/bin/sh
set -e

case "$1" in
  configure)
    HELPER_SCHEMAS="/usr/share/gnome-shell/extensions/opaline-desktop@ali-kenjo.github.io/schemas"
    if [ -d "$HELPER_SCHEMAS" ] && command -v glib-compile-schemas >/dev/null 2>&1; then
      glib-compile-schemas "$HELPER_SCHEMAS" || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
    fi
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet dbus.service 2>/dev/null; then
      systemctl reload dbus.service || true
    fi
    ;;
esac

exit 0
