{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Core-owned Settings and Onboarding windows: configuration, diagnostics, backup, and updates only.",
  "windows": ["settings", "onboarding"],
  "permissions": [
    "allow-shell-get-state",
    "allow-shell-update-settings",
    "allow-shell-reset-settings",
    "allow-shell-update-layouts",
    "allow-shell-set-autostart",
    "allow-shell-set-helper-enabled",
    "allow-shell-set-shortcuts",
    "allow-shell-export-backup",
    "allow-shell-import-backup",
    "allow-shell-diagnostics",
    "allow-shell-check-updates",
    "allow-shell-install-update",
    "allow-shell-trigger-action",
    "allow-shell-geocode",
    "allow-shell-list-fonts",
    "allow-shell-wallpaper-asset",
    "allow-shell-close"
  ]
}
